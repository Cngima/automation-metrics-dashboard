# Copy this file to .env and fill in your own values. .env is never committed.
MAKE_BASE_URL=https://eu1.make.com/api/v2
MAKE_API_TOKEN=
MAKE_DATA_STORE_ID=
AMD_DB_PATH=data/private/metrics.db

# Optional: email alerts (use an app password, not your normal password)
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional AI suggestions for unclassified notes: off | claude_code | ollama
AI_PROVIDER=off
